# Copy this file to .env and fill in your values.
# Get a bot token from @BotFather on Telegram.

TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_token_here
# Optional: only allow alerts/commands from this chat id (run /start first
# to discover yours). Leave empty during initial setup.
TELEGRAM_ALLOWED_CHAT_ID=

# Default paper-buy quantity used by Telegram inline buttons.
PAPER_BUY_QTY=10

# --- Background scheduler ---
# When the daily scan should run. Default: 16:00 IST on weekdays
# (30 minutes after NSE close at 15:30).
SCAN_SCHEDULE_HOUR=16
SCAN_SCHEDULE_MINUTE=0
SCAN_SCHEDULE_DAYS=mon-fri
# Set to 'true' to also run a scan immediately when the server starts
# (useful when testing).
RUN_SCAN_ON_STARTUP=false

# --- Phase 3 (NOT YET IMPLEMENTED) ---
# When you're ready to wire real orders via Zerodha Kite Connect:
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
# MAX_TRADE_VALUE_INR=5000
# MAX_DAILY_LOSS_INR=400
